# Claude Code per-machine config
.claude/settings.local.json

# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/

# IDEs
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
*.log

# Env (loaded at runtime via flutter_dotenv — never commit real values)
.env
.env.*
!.env.example

# iOS
ios/Pods/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/.symlinks/
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/key.jks
android/app/keystore.jks
android/captures/
android/gradlew
android/gradlew.bat


# Native secrets (never commit — see docs/SECURITY.md)
google-services.json
GoogleService-Info.plist
*.jks
*.keystore
*service-account*.json

# Generated code (*.g.dart, *.freezed.dart, lib/src/rust/) IS committed in this
# stack, so a fresh clone runs with `flutter run` and no codegen step.
# Regenerate after changes — never hand-edit:
#   dart run build_runner build --delete-conflicting-outputs
#   flutter_rust_bridge_codegen generate
**/generated_plugin_registrant.dart

# Exception: firebase_options.dart is generated but MUST be committed.
# It contains the web API key, which is NOT secret (see master spec §5 gotcha #2).
!lib/firebase_options.dart

# Rust
rust/target/
rust/core/target/
rust_builder/cargokit/build_tool/.dart_tool/

# Flutter tooling
.flutter-plugins-dependencies
.metadata.bak

# Cloudflare Worker (build output, local D1 state, local secrets)
rust/api/build/
rust/api/.wrangler/
rust/api/node_modules/
.dev.vars

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Codemagic local artifacts
codemagic-build-output/
